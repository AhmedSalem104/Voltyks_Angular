## Material Datepicker with Arabic Localization

### Custom Arabic Date Adapter
**File**: `reports.component.ts` (lines 15-37)

```typescript
class ArabicDateAdapter extends NativeDateAdapter {
  override getFirstDayOfWeek(): number {
    return 6; // Saturday
  }

  override getDayOfWeekNames(style: 'long' | 'short' | 'narrow'): string[] {
    if (style === 'narrow') {
      return ['ح', 'ن', 'ث', 'ر', 'خ', 'ج', 'س'];
    }
    return ['الأحد', 'الإثنين', 'الثلاثاء', 'الأربعاء', 'الخميس', 'الجمعة', 'السبت'];
  }

  override getMonthNames(style: 'long' | 'short' | 'narrow'): string[] {
    return [
      'يناير', 'فبراير', 'مارس', 'أبريل', 'مايو', 'يونيو',
      'يوليو', 'أغسطس', 'سبتمبر', 'أكتوبر', 'نوفمبر', 'ديسمبر'
    ];
  }
}
```

### Provider Configuration
```typescript
@Component({
  providers: [
    { provide: MAT_DATE_LOCALE, useValue: 'ar-EG' },
    { provide: DateAdapter, useClass: ArabicDateAdapter }
  ]
})
```

### HTML Template Usage
```html
<mat-form-field class="voltyks-datepicker" appearance="outline">
  <mat-label>من تاريخ</mat-label>
  <input
    matInput
    [matDatepicker]="startPicker"
    [(ngModel)]="startDateObj"
    placeholder="اختر تاريخ البداية"
  />
  <mat-datepicker-toggle matIconSuffix [for]="startPicker">
  </mat-datepicker-toggle>
  <mat-datepicker #startPicker></mat-datepicker>
</mat-form-field>
```

### Date Formatting Functions

**Short Format** (for tables):
```typescript
formatDate(dateString: string): string {
  const date = new Date(dateString);
  return date.toLocaleDateString('ar-EG', {
    year: 'numeric',
    month: 'short',
    day: 'numeric',
    hour: '2-digit',
    minute: '2-digit'
  });
}
```

**Long Format** (for tooltips):
```typescript
formatDateLong(dateString: string): string {
  const date = new Date(dateString);
  return date.toLocaleDateString('ar-EG', {
    weekday: 'long',
    year: 'numeric',
    month: 'long',
    day: 'numeric',
    hour: '2-digit',
    minute: '2-digit'
  });
}
```

**Relative Time** (human-readable):
```typescript
getRelativeTime(dateString: string): string {
  const date = new Date(dateString);
  const now = new Date();
  const diffMs = now.getTime() - date.getTime();
  const diffMinutes = Math.floor(diffMs / 60000);
  const diffHours = Math.floor(diffMs / 3600000);
  const diffDays = Math.floor(diffMs / 86400000);

  if (diffMinutes < 1) return 'الآن';
  if (diffMinutes < 60) return `منذ ${diffMinutes} دقيقة`;
  if (diffHours < 24) return `منذ ${diffHours} ساعة`;
  if (diffDays === 1) return 'أمس';
  if (diffDays < 7) return `منذ ${diffDays} أيام`;
  // ... more conditions
}
```

### Enhanced Datepicker Button Styling
```scss
.mat-datepicker-toggle {
  .mat-mdc-icon-button {
    width: 36px !important;
    height: 36px !important;
    border-radius: 50% !important;
    background: linear-gradient(135deg, rgba(0, 200, 83, 0.15), rgba(0, 200, 83, 0.08)) !important;
    border: 1.5px solid rgba(0, 200, 83, 0.3) !important;

    // Calendar icon using CSS
    &::before {
      content: '\e935' !important; // Material Icons calendar
      font-family: 'Material Icons' !important;
      font-size: 20px !important;
      color: #00C853 !important;
    }

    &:hover {
      transform: scale(1.1) rotate(5deg) !important;
      box-shadow: 0 4px 16px rgba(0, 200, 83, 0.4) !important;
    }
  }
}
```

