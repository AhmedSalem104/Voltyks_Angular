{
  "buildCommand": "npm run build",
  "outputDirectory": "voltyks-admin/dist/voltyks-admin/browser",
  "installCommand": "npm run vercel-install",
  "rewrites": [
    {
      "source": "/api/proxy/:path*",
      "destination": "/api/proxy"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ]
}
