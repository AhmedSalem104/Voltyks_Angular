{
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://corsproxy.io/?http://voltyks-app.runasp.net/api/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "buildCommand": "npm run build",
  "outputDirectory": "voltyks-admin/dist/voltyks-admin/browser",
  "installCommand": "npm run vercel-install"
}
