{
  "buildCommand": "npm run build",
  "outputDirectory": "voltyks-admin/dist/voltyks-admin/browser",
  "installCommand": "npm run vercel-install",
  "functions": {
    "api/[...slug].js": {
      "maxDuration": 30
    }
  },
  "rewrites": [
    {
      "source": "/api/:slug*",
      "destination": "/api/:slug*"
    },
    {
      "source": "/:path((?!api/).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600, s-maxage=3600"
        }
      ]
    }
  ]
}
