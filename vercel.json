{
  "buildCommand": "cd voltyks-admin && npm install && npm run build",
  "outputDirectory": "voltyks-admin/dist/voltyks-admin/browser",
  "framework": null,
  "functions": {
    "api/proxy.js": {
      "includeFiles": "api/**"
    }
  },
  "rewrites": [
    { "source": "/api/proxy/:path*", "destination": "/api/proxy" },
    { "source": "/api/proxy", "destination": "/api/proxy" },
    { "source": "/:path*", "destination": "/index.html" }
  ]
}
