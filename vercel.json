{
  "version": 2,
  "builds": [
    {
      "src": "api/*.js",
      "use": "@vercel/node"
    },
    {
      "src": "voltyks-admin/package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "dist/voltyks-admin/browser"
      }
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "/api/proxy.js"
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/(.*)",
      "dest": "/voltyks-admin/$1"
    }
  ]
}
