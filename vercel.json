{
  "buildCommand": "cd voltyks-admin && npm run build",
  "outputDirectory": "voltyks-admin/dist/voltyks-admin/browser",
  "installCommand": "cd voltyks-admin && npm install",
  "framework": null,
  "functions": {
    "api/proxy.js": {
      "memory": 1024,
      "maxDuration": 30
    }
  },
  "rewrites": [
    {
      "source": "/api/proxy/:path*",
      "destination": "/api/proxy?path=/:path*"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ]
}
